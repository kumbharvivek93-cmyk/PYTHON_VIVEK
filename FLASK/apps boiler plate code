from flask import Flask,render_template,redirect,session,flash,request,url_for
from flask_sqlalchemy import SQLAlchemy  # module importing section
from datetime import timedelta,datetime

app=Flask(__name__)
app.config['SQLALCHEMY_DATABASE_URI']='sqlite:///loginlogout.sqlite3'
app.config['SQLALCHEMY_TRACK_MODIFICATIONS']=False   # instace making section 
app.permanent_session_lifetime=timedelta(days=2)
app.secret_key='vivekkali'
db=SQLAlchemy(app)

class Loginlogout(db.Model):
    id=db.Column(db.Integer,primary_key=True)
    name=db.Column(db.String(30),nullable=False)     # database section 
    email=db.Column(db.String(50),nullable=False)
    password=db.Column(db.String(50),nullable=False)
    mobile_no=db.Column(db.String(13),nullable=False)
    created_at=db.Column(db.DateTime,default=datetime.utcnow,nullable=False)   # CamelCasing in case of created at coloumn

def string_validator(sample):
    if sample.strip() or len(sample)>2:
        return f'enter a valid {sample}'

with app.app_context():
    db.create_all()                     
    print("database is created")

@app.route("/")      # route section
def home():
    return render_template("index.html")

@app.route('/login',methods=['GET','POST'])
def login():
    if request.method=='POST':
        email=request.form.get("email")
        password=request.form.get("password")

        string_validator(email)
        string_validator(password)

        user=Loginlogout.query.filter_by(email=email).first()

        if user :
            if user.password==password:
                return "user founded logged in successfully"
        else:
            return "user not found"
    else:
        return render_template("login.html")

@app.route('/signup',methods=['GET','POST'])
def signup():
    if request.method=='POST':
        name=request.form.get("name")
        mobile_no=request.form.get("mobile_no")
        email=request.form.get("email")
        password=request.form.get("password")

        string_validator(name)
        string_validator(email)
        string_validator(password)

        if mobile_no.strip()=="" or len(mobile_no)!=10:
            return "enter a valid mobile no"
        session['name']=name
        

        new_user=Loginlogout(
            name=name,
            mobile_no=mobile_no,
            email=email,
            password=password
        )
        try:
            db.session.add(new_user)
            db.session.commit()
            print("user added to the database !")
            return "sighned up successfully thank you"
        except Exception as e:
            db.session.rollback()
            print(e)
            return "signup failed something went wrong !"
    else:
        return render_template("signup.html")

@app.route('/logout')
def logout():
    if request.method=='POST':
        response=request.form.get("response")
        if response=="yes":
            session.pop('name',None)
            flash("logged out successfull")
            return redirect(url_for("home"))
        else:
            flash("logout cancelled")
            return redirect(url_for("home"))
    else:
        return render_template("logout.html")



if __name__=='__main__':  # running conditions
    app.run(debug=True)
