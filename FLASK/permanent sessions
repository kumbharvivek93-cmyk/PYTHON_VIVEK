to make a session permenent 
STEP 1 :  from datetime import timedelta

>>> form datetime import timedelta

STEP 2 : make a instanse of the permant sesion or we can say that set up time to live the session

app.permanent_session_lifetime=timedelta(days=n)  # we can also pass mints= of hours= like that

STEP 3 :  make true session.permanent=True in the file / site / function in which we are assighning the session

code example :;

rom flask import Flask,render_template,redirect,url_for,request,session
from datetime import timedelta
app=Flask(__name__)
app.secret_key="vivekkali"
app.permanent_session_lifetime=timedelta(days=2)
@app.route("/")
def home():
    return render_template("index.html")
@app.route("/login",methods=["GET","POST"])
def login():
    session.permanent=True
    if request.method=="POST":
        password=request.form.get("password")
        session["password"]=password
        return "<h3> login successful</h3>"
    else:
        if "password" in session:
            return redirect(url_for("home"))
        return render_template("login.html")
            
    
@app.route("/data") 
def user():
    if "password" in session:
        final_password=session["password"]
        return f"password is {final_password}"
    else:
        return render_template("index.html")
    
@app.route("/logout")
def logout():
    session.pop("password",None)
    return redirect(url_for("login"))
    

if __name__=="__main__":
    app.run(debug=True)
