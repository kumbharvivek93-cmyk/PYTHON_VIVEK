from flask import Flask,redirect,render_template,request,session,url_for
from flask_sqlalchemy import SQLAlchemy
from datetime import timedelta,datetime

app=Flask(__name__)
app.secret_key="vivekkail"
app.config['SQLALCHEMY_DATABASE_URI']="sqlite:///dada.sqlite3"
app.config['SQLALCHEMY_TRACK_MODIFICATIONS']=False
app.permanent_session_lifetime=timedelta(minutes=60)
db=SQLAlchemy(app)

def string_validator(string):
    if not string or string.strip()=="":
        return f"enter a valid {string}"
 
class dada(db.Model):
    id=db.Column(db.Integer,primary_key=True)
    name=db.Column(db.String(30),nullable=False)
    password=db.Column(db.String(50),nullable=False)
    created_at = db.Column(db.DateTime, default=datetime.utcnow, nullable=False)
with app.app_context():
    db.create_all()
    print("database is created !")

@app.route("/",methods=['GET','POST'])
def home():
    session.permanent=True
    if request.method=='POST':
        name=request.form.get("name")
        password=request.form.get("password")

        res=string_validator(name)
        res=string_validator(password)

        new_user=dada(
            name=name,
            password=password
        )

        try:
            db.session.add(new_user)
            db.session.commit()
            print("User added to database !")
        except Exception as e :
            db.session.rollback()
            print(e)
        
        return "connected succesfully ! "
    
    else:
        return render_template("sophos_index.html")

