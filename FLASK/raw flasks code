from flask import Flask,redirect,session,request,render_template,url_for,flash
from flask_sqlalchemy import SQLAlchemy
from datetime import timedelta
import os

app=Flask(__name__)
app.secret_key="vivekkali"
app.config["SQLALCHEMY_DATABASE_URI"]='sqlite:///testing.sqlite3'
app.config["SQLALCHEMY_TRACK_MODIFICATIONS"]=False
db=SQLAlchemy(app)
app.permanent_session_lifetime=timedelta(minutes=15)

class testing(db.Model):
    name=db.Column(db.String(30))
    mo=db.Column(db.String(30))
    adhar=db.Column(db.String(30),primary_key=True)

    def __int__(self,name,mo,adhar):
        self.name=name
        self.mo=mo
        self.adhar=adhar

with app.app_context():
    db.create_all()

   # define function here if needed 


@app.route("/", methods=["GET","POST"])
def home():
    session.permanent=True
    if request.method=="POST":
        name=request.form.get("name")
        mo=request.form.get("mo")
        adhar=request.form.get("adhar")

        session["name"]=name
        session["mo"]=mo
        session["adhar"]=adhar

        new_user=testing(
            name=name,
            mo=mo,
            adhar=adhar
        )
        
        try:
            db.session.add(new_user)
            db.session.commit()
            print("user added in database")
        except Exception as e :
            db.session.rollback()
            print(e)

        return "user added successfully !!"
    else:
        if "name" in session:
            return "logged in already !!"
        else :
            return render_template("testing.html")

    

if __name__=="__main__":
    app.run(debug=True)

 
