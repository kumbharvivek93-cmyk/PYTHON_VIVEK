@app.route("/",methods=['GET','POST'])
def home():
    if request.method=="POST":
        name=request.form.get("name")
        address=request.form.get("address")
        mobile_no=request.form.get("mobile_no")
        activity=request.form.get("activity")
        
        hight=float(request.form.get("hight"))
        weight=float(request.form.get("weight"))
        age=float(request.form.get("age"))
        

        if not name or len(name)<2 or name.strip()=="":
            return "enterd name is incorrect"
        if not address or len(address)<4 or address.strip()=="":
            return "enterd address is incorrect"
        if not mobile_no or len(mobile_no)<2 or mobile_no.strip()=="" or len(mobile_no) !=10:
            return "enterd mobile no is incorrect"
        if not age  or age=="":
            return "enterd age is incorrect"                    # type error in the code
        if not weight or weight=="":
            return "enterd weight is incorrect"
        if not hight or hight=="":
            return "enterd hight is incorrect"
        if not activity or len(activity)<2 or activity.strip()=="":
            return "enterd activity is incorrect"
        
        
        session["name"]=name
        session["address"]=address
        session["mobile_no"]=mobile_no
        session["activity"]=activity
        session["hight"]=hight
        session["weight"]=weight
        session["age"]=age

        response=suggest_diet(hight=hight,weight=weight)
        session["res"]=response

        new_user=me(
            name=name,
            address=address,
            mobile_no=mobile_no,
            activity=activity,
            hight=hight,
            weight=weight,
            age=age          
        )

        try:
            db.session.add(new_user)
            db.session.commit()
            print("user added to database")
        except Exception as e :
            db.session.rollback()
            print(e)
            
        return redirect(url_for('result'))
    else :
        return render_template("me.html")
    
@app.route("/result",methods=["GET","POST"])
def result():
    rating=session["res"]
    return render_template("result.html",rating=rating)



if __name__=="__main__":
    app.run(debug=True)
