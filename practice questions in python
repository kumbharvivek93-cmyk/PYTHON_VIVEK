# append the zeros to the left
l=[]
for i in range(10):
    a=int(input("enter 10 numbers to enter in a list ::"))
    l.append(a)
score=0
zero_idx=[]
idx=0
for i in l:
    if i==0:
        score+=1
        zero_idx.append(idx)
    idx+=1
print(f'there are {score} zeros present in the list :')
print("present at these indexes ->")
print(zero_idx)
present=0
for i in zero_idx:
    l.remove(l[i-present])
    present+=1
for i in range(score):
    l.append(0)
print("final modified list is ::")
print(l)
        
